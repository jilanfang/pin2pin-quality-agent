{
  "name": "ai-quality-demo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3001",
    "smoke:browser": "bash ./scripts/browser-smoke.sh",
    "smoke:local": "bash ./scripts/local-prod-smoke.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push",
    "auth:user": "node scripts/manage-auth-user.mjs",
    "test:e2e:setup": "docker compose -f docker-compose.test.yml up -d --wait && DATABASE_URL=postgres://test_user:test_pass@localhost:5433/ai_quality_test npm run db:push",
    "test:e2e:teardown": "docker compose -f docker-compose.test.yml down -v",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:browser": "npx playwright test --config tests/e2e-browser/playwright.config.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.100.1",
    "drizzle-orm": "^0.44.5",
    "next": "^15.3.1",
    "postgres": "^3.4.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "drizzle-kit": "^0.31.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
